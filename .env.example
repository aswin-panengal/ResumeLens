# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Django Core
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True
# In production, comma-separate your domains:
# ALLOWED_HOSTS=resumelens.up.railway.app,www.yourdomain.com

# LLM APIs
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=your-groq-api-key

# Email (Gmail App Password — NOT your Gmail login password)
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password

# Dev-only: skip OTP email verification during local testing
BYPASS_OTP=True

# --- Production services (leave blank for local dev) ---

# PostgreSQL via Supabase or Neon
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ChromaDB Cloud (https://trychroma.com)
# CHROMA_HOST=api.trychroma.com
# CHROMA_API_KEY=ck-your-chroma-cloud-key

# Cloudinary — uploaded resumes survive container restarts
# Sign up free at https://cloudinary.com
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
